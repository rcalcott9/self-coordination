def prior_confirmed():
    """{stimulus: {model: row}} from the confirmed n=60 sample (old model versions)."""
    out = {}
    for r in csv.DictReader(open(CONFIRM_CSV)):
        out.setdefault(r["stimulus_pair"], {})[r["model"]] = r
    return out


def build_manifest(write=True):
    """Verify all 15 stimuli against the registry AND the confirmed data, then freeze.

    Fails loudly rather than silently substituting a similarly-named stimulus.
    """
    reg = tc.registry()
    prior = prior_confirmed()
    rows, problems = [], []
    for sid in BATTERY:
        e = reg.get(sid)
        if not e:
            problems.append(f"{sid}: not in registry"); continue
        ab, ba = tc.paths(e)
        for p in (ab, ba):
            if not os.path.exists(p):
                problems.append(f"{sid}: missing {p}")
        pr = prior.get(sid)
        if sid in EXTRA_STIMULI:
            # structural verification only - there is no prior run to compare against
            if not e.get("identity_1") or e["identity_1"] == e.get("identity_2"):
                problems.append(f"{sid}: identities missing or identical")
            rows.append(dict(
                stimulus_id=sid, family=e.get("family", ""), source=e["source"],
                identity_1=e["identity_1"], identity_2=e["identity_2"],
                path_AB=ab, path_BA=ba,
                local_AB=os.path.join(STIM_LOCAL, f"{sid}_AB.png"),
                local_BA=os.path.join(STIM_LOCAL, f"{sid}_BA.png"),
                prior_class_report="expansion",
                prior_note_report="prospective expansion battery; no prior run",
                prior_gpt_match="", prior_claude_match="",
                prior_delta_gpt_minus_claude="",
                prior_gpt_form_consistency="", prior_claude_form_consistency="",
                prior_gpt_fallback="", prior_claude_fallback="",
                prior_n_gpt="", prior_n_claude="",
            ))
            continue
        if not pr or "gpt" not in pr or "claude" not in pr:
            problems.append(f"{sid}: absent from confirmation summary"); continue
        g, c = pr["gpt"], pr["claude"]
        gm, cm = float(g["match_unbiased"]), float(c["match_unbiased"])
        gfc, cfc = float(g["form_consistency"]), float(c["form_consistency"])
        cls, note = REPORT_CLASS[sid]

        # IDENTITY CODING. The registry and the confirmed run must agree on which
        # identity is 1 and which is 2. If they disagree, every AB/BA recoding in
        # this experiment is mirrored relative to the confirmed battery and the
        # old-vs-new comparison silently compares p to 1-p.
        for who, row in (("gpt", g), ("claude", c)):
            for k in ("identity_1", "identity_2"):
                if row.get(k) and row[k] != e[k]:
                    problems.append(
                        f"{sid}: {k} disagrees with the confirmed run ({who}): "
                        f"registry={e[k]!r} confirmed={row[k]!r}")

        # CLASSIFICATION. Re-derive the clean/fallback distinction from the data
        # and require it to agree with the hand-entered REPORT_CLASS label.
        d = gm - cm
        derived_fb = (gfc < FC_CLEAN) or (cfc < FC_CLEAN)
        if cls == "clean_disparity":
            if derived_fb:
                problems.append(
                    f"{sid}: labelled clean_disparity but a model is below the "
                    f"{FC_CLEAN} form-consistency bar (gFC={gfc}, cFC={cfc})")
            if abs(d) < 0.10:
                problems.append(
                    f"{sid}: labelled clean_disparity but |delta|={abs(d):.3f} is tiny")
        elif cls == "fallback_disparity":
            if not derived_fb:
                problems.append(
                    f"{sid}: labelled fallback_disparity but BOTH models are at or "
                    f"above the {FC_CLEAN} bar (gFC={gfc}, cFC={cfc})")
        elif cls == "shared_control" and abs(d) > 0.20:
            problems.append(
                f"{sid}: labelled shared_control but |delta|={abs(d):.3f} > 0.20")
        rows.append(dict(
            stimulus_id=sid, family=e.get("family", ""), source=e["source"],
            identity_1=e["identity_1"], identity_2=e["identity_2"],
            path_AB=ab, path_BA=ba,
            local_AB=os.path.join(STIM_LOCAL, f"{sid}_AB.png"),
            local_BA=os.path.join(STIM_LOCAL, f"{sid}_BA.png"),
            prior_class_report=cls, prior_note_report=note,
            prior_gpt_match=round(gm, 4), prior_claude_match=round(cm, 4),
            prior_delta_gpt_minus_claude=round(gm - cm, 4),
            prior_gpt_form_consistency=gfc, prior_claude_form_consistency=cfc,
            # stored as strings so a freshly-built manifest and one round-tripped
            # through CSV compare identically everywhere downstream
            prior_gpt_fallback=str(gfc < FC_CLEAN),
            prior_claude_fallback=str(cfc < FC_CLEAN),
            prior_n_gpt=g["n_valid"], prior_n_claude=c["n_valid"],
        ))
    if problems:
        sys.exit("STIMULUS VERIFICATION FAILED:\n  " + "\n  ".join(problems))
    if write:
        os.makedirs(STIM_LOCAL, exist_ok=True)
        import shutil
        for r in rows:                       # self-contained copies, project convention
            for src, dst in ((r["path_AB"], r["local_AB"]), (r["path_BA"], r["local_BA"])):
                if not os.path.exists(dst):
                    shutil.copy2(src, dst)
        with open(MANIFEST, "w", newline="") as fh:
            w = csv.DictWriter(fh, fieldnames=list(rows[0]))
            w.writeheader(); w.writerows(rows)
    return rows


def load_manifest():
    if not os.path.exists(MANIFEST):
        return build_manifest()
    return list(csv.DictReader(open(MANIFEST)))


def registry_entry(sid):
    """Registry entry for a stimulus, with identities from the frozen manifest."""
    e = dict(tc.registry()[sid])
    return e


def load_images(sids=None):
    """{(sid, variant): b64}. Reads the LOCAL frozen copies."""
    man = {r["stimulus_id"]: r for r in load_manifest()}
    img = {}
    for sid in (sids or BATTERY):
        r = man[sid]
        for variant, key in (("AB", "local_AB"), ("BA", "local_BA")):
            p = r[key] if os.path.exists(r[key]) else r[f"path_{variant}"]
            with open(p, "rb") as fh:
                img[(sid, variant)] = base64.standard_b64encode(fh.read()).decode()
    return img


def slot_identities(sid, variant):
    """(identity shown LEFT, identity shown RIGHT). AB puts identity_1 on the left."""
    man = {r["stimulus_id"]: r for r in load_manifest()}
    i1, i2 = man[sid]["identity_1"], man[sid]["identity_2"]
    return (i1, i2) if variant == "AB" else (i2, i1)


