def ask_gpt(client, img_b64, prompt):
    kw = dict(
        model=GPT_ID,
        input=[{"role": "user", "content": [
            {"type": "input_text", "text": prompt},
            {"type": "input_image", "image_url": f"data:image/png;base64,{img_b64}"}]}])
    if GPT_SURFACE == "reasoning":
        kw["reasoning"] = {"effort": "low", "summary": "auto"}
    else:
        kw["temperature"] = LADDER_TEMP
    r = client.responses.create(**kw)
    reasoning = ""
    for item in r.output:
        if item.type == "reasoning" and item.summary:
            reasoning = " ".join(p.text for p in item.summary)
            break
    return (r.output_text or ""), reasoning, getattr(r, "model", GPT_ID)


def ask_claude(client, img_b64, prompt):
    kw = dict(
        model=CLAUDE_ID,
        max_tokens=CLAUDE_SETTINGS["max_tokens"],
        messages=[{"role": "user", "content": [
            {"type": "image", "source": {"type": "base64", "media_type": "image/png",
                                         "data": img_b64}},
            {"type": "text", "text": prompt}]}])
    if CLAUDE_SURFACE == "thinking":
        kw["thinking"] = {"type": "adaptive", "display": "summarized"}
        kw["output_config"] = {"effort": "low"}
    else:
        kw["temperature"] = LADDER_TEMP
    r = client.messages.create(**kw)
    reasoning, answer = "", ""
    for b in r.content:
        if b.type == "thinking":
            reasoning = b.thinking or ""
        elif b.type == "text":
            answer += b.text
    return answer, reasoning, getattr(r, "model", CLAUDE_ID)


