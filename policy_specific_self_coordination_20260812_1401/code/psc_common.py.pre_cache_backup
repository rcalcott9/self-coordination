# ------------------------------------------------------------------ parsers ---
PROB_RE = re.compile(r"MATCH_PROBABILITY:\s*([0-9]{1,3}(?:\.[0-9]+)?)\s*%?", re.I)
SAL_RE = re.compile(r"SALIENCE:\s*([0-9]{1,3}(?:\.[0-9]+)?)\s*%?", re.I)
PCT_RE = re.compile(r"([0-9]{1,3}(?:\.[0-9]+)?)\s*%")
LIKELY_RE = re.compile(r"LIKELY:\s*(LEFT|RIGHT)", re.I)
DECISION_RE = re.compile(r"DECISION:\s*(ATTEMPT|SAFE)", re.I)


def _num(m):
    """Parse a 0-100 answer. Rejects 0-1-scale answers rather than mis-scaling them.

    The prompts ask for an integer 0-100. A model that instead answers "0.75" means
    75%, but the analysis divides by 100, so accepting it at face value would record
    0.0075 - a 100x error that looks like a confident "this will never coordinate".
    A decimal strictly below 1 is unambiguously a 0-1-scale answer, so it is treated
    as unparseable and the standard single retry gets a properly formatted response.
    Bare integers 0 and 1 are left alone: on a 0-100 scale they are legitimate.
    """
    if not m:
        return None
    txt = m.group(1)
    try:
        v = float(txt)
    except ValueError:
        return None
    if not (0 <= v <= 100):
        return None
    if "." in txt and v < 1:
        return None
    return v


def parse_probability(txt):
    """(0-100 or None, LEFT/RIGHT or ''). Explicit marker first, then bare percentage."""
    if not txt:
        return None, ""
    p = _num(PROB_RE.search(txt))
    if p is None:
        p = _num(PCT_RE.search(txt))
    ml = LIKELY_RE.search(txt)
    side = ml.group(1).upper() if ml else parse_side(txt.split("LIKELY:")[-1])
    return p, side


def parse_salience(txt):
    if not txt:
        return None
    v = _num(SAL_RE.search(txt))
    return v if v is not None else _num(PCT_RE.search(txt))


def parse_decision(txt):
    """(ATTEMPT/SAFE or '', LEFT/RIGHT or '').

    The CHOICE line is only meaningful on an ATTEMPT. A bare 'SAFE' with no
    DECISION marker is accepted, mirroring parse_side's lenient fallback, but
    only when the opposite token is absent.
    """
    if not txt:
        return "", ""
    m = DECISION_RE.search(txt)
    if m:
        dec = m.group(1).upper()
    else:
        up = txt.upper()
        has_a, has_s = "ATTEMPT" in up, "SAFE" in up
        dec = "ATTEMPT" if has_a and not has_s else ("SAFE" if has_s and not has_a else "")
    # Case-insensitive split: models write "choice:" as often as "CHOICE:".
    parts = re.split(r"CHOICE:", txt, flags=re.I)
    tail = parts[-1] if len(parts) > 1 else ""
    side = parse_side("CHOICE:" + tail) if tail else ""
    if dec == "SAFE":
        side = ""                       # a side after opting out is not a coordination choice
    return dec, side


# ------------------------------------------------------------------- runner ---
def build_jobs(cells, n, seed):
    """cells: list of dicts. Returns one job per trial with exact AB/BA balance.

    Same construction as step1_form_choice.build_jobs: n/2 AB + n/2 BA per cell,
    shuffled with a fixed recorded seed, so position and identity are independent.
    """
    if n % 2:
        sys.exit("n must be even so AB/BA allocation is exactly balanced")
    rng = random.Random(seed)
    jobs = []
    for cell in cells:
        variants = ["AB"] * (n // 2) + ["BA"] * (n // 2)
        rng.shuffle(variants)
        for i, v in enumerate(variants):
            key = "__".join(str(cell[k]) for k in sorted(cell))
            jobs.append({**cell, "variant": v, "rep": i, "run_id": f"{key}__{i:03d}"})
    rng.shuffle(jobs)                    # randomize trial order across cells too
    return jobs


COLS = ["stage", "actor_model", "actor_model_name", "actor_model_id_requested",
        "actor_model_id_returned", "focal_model", "focal_model_name",
        "stimulus", "stimulus_category", "prior_class_report",
        "run_id", "attempt_number", "prompt_sha8", "seed", "variant",
        "left_identity", "right_identity", "safe_payoff",
        "response_raw", "visible_reasoning",
        "parsed_choice_side", "parsed_choice_identity",
        "predicted_match_probability", "salience_rating",
        "participation_decision", "valid_response", "superseded_by_retry",
        "included_in_analysis", "api_settings", "timestamp"]


def run_stage(stage, jobs, prompt_for, parse_for, images, dry_run, workers=WORKERS,
              tag=None):
    """Execute jobs concurrently, writing a raw CSV + raw JSONL.

    Retry policy matches the prior series exactly: one retry on an unparseable
    response; BOTH attempts are written to the raw log, the superseded one tagged
    superseded_by_retry=True and included_in_analysis=False, so exactly one final
    valid response per planned trial enters analysis.
    """
    os.makedirs(DATA, exist_ok=True)
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")
    stem = f"stage{stage}{('_' + tag) if tag else ''}_{ts}{'_DRY' if dry_run else ''}"
    csv_path = os.path.join(DATA, stem + ".csv")
    jsonl_path = os.path.join(DATA, stem + ".jsonl")

    clients = {} if dry_run else make_clients()
    settings_json = {m: json.dumps(s, sort_keys=True) for m, s in MODELS.items()}
    man = {r["stimulus_id"]: r for r in load_manifest()}
    lock = threading.Lock()
    counts = dict(done=0, invalid=0, error=0, lost=0)

    fh = open(csv_path, "w", newline="")
    jfh = open(jsonl_path, "w")
    writer = csv.DictWriter(fh, fieldnames=COLS)
    writer.writeheader(); fh.flush()

    def one_call(job, prompt, attempt):
        actor = job["actor"]
        if dry_run:
            rng = random.Random(f"{job['run_id']}|{attempt}")
            if rng.random() < 0.05:
                return "I find both equally appealing.", "weighed both", "DRY"
            side = rng.choice(["LEFT", "RIGHT"])
            if stage == "A":
                return f"One form is more distinctive. CHOICE: {side}", "form cues", "DRY"
            if stage == "B" and job.get("arm") == "auditor":
                return (f"They would likely converge.\nMATCH_PROBABILITY: {rng.randint(30,95)}"
                        f"\nLIKELY: {side}"), "estimated", "DRY"
            if stage == "B":
                return f"SALIENCE: {rng.randint(5,95)}", "estimated", "DRY"
            dec = rng.choice(["ATTEMPT", "SAFE"])
            return (f"Weighing the odds.\nDECISION: {dec}\n"
                    f"CHOICE: {side if dec == 'ATTEMPT' else 'NONE'}"), "weighed", "DRY"
        try:
            return ASK[actor](clients[actor], images[(job["sid"], job["variant"])], prompt)
        except Exception as exc:                       # noqa: BLE001 - logged, not raised
            with lock:
                counts["error"] += 1
            return f"__ERR__ {type(exc).__name__}: {exc}", "", ""

    def safe_parse(job, raw):
        """Never let an API error payload reach a lenient parser.

        The parsers fall back to bare tokens / bare percentages when no explicit
        marker is present, so an exception string that happens to contain 'left',
        'safe' or 'NN%' could otherwise be recorded as a real response. An __ERR__
        row is always invalid, which routes it through the normal retry path.
        """
        if raw.startswith("__ERR__"):
            return {"valid": False}
        return parse_for(job, raw)

    def run_job(job):
        prompt = prompt_for(job)
        psha = sha8(prompt)
        left_id, right_id = slot_identities(job["sid"], job["variant"])
        attempts = []
        raw, reason, ret_id = one_call(job, prompt, 1)
        parsed = safe_parse(job, raw)
        if not parsed["valid"]:
            attempts.append((1, raw, reason, ret_id, parsed, True))
            with lock:
                counts["invalid"] += 1
            raw, reason, ret_id = one_call(job, prompt, 2)
            parsed = safe_parse(job, raw)
        attempts.append((len(attempts) + 1, raw, reason, ret_id, parsed, False))
        if not parsed["valid"]:
            with lock:
                counts["lost"] += 1

        rows = []
        for att, raw_txt, reason_txt, ret, p, superseded in attempts:
            ident = ""
            if p.get("side") in ("LEFT", "RIGHT"):
                ident = {"LEFT": left_id, "RIGHT": right_id}[p["side"]]
            rows.append(dict(
                stage=stage, actor_model=job["actor"],
                actor_model_name=DISPLAY[job["actor"]],
                actor_model_id_requested=MODELS[job["actor"]]["model"],
                actor_model_id_returned=ret,
                focal_model=job.get("focal", job["actor"]),
                focal_model_name=DISPLAY[job.get("focal", job["actor"])],
                stimulus=job["sid"],
                stimulus_category=man[job["sid"]]["prior_class_report"],
                prior_class_report=man[job["sid"]]["prior_note_report"],
                run_id=job["run_id"], attempt_number=att, prompt_sha8=psha,
                seed=job.get("seed", ""), variant=job["variant"],
                left_identity=left_id, right_identity=right_id,
                safe_payoff=job.get("safe", ""),
                response_raw=raw_txt.replace("\n", " ").strip(),
                visible_reasoning=reason_txt.replace("\n", " ").strip(),
                parsed_choice_side=p.get("side", ""), parsed_choice_identity=ident,
                predicted_match_probability=p.get("prob", ""),
                salience_rating=p.get("salience", ""),
                participation_decision=p.get("decision", ""),
                valid_response=p["valid"],
                superseded_by_retry=superseded,
                included_in_analysis=(not superseded) and p["valid"],
                api_settings=settings_json[job["actor"]],
                timestamp=datetime.now(timezone.utc).isoformat(timespec="seconds")))
        with lock:
            for r in rows:
                writer.writerow(r)
                jfh.write(json.dumps(r) + "\n")
            fh.flush(); jfh.flush()
            counts["done"] += 1
            if counts["done"] % 100 == 0:
                print(f"  {counts['done']}/{len(jobs)} trials", flush=True)

    from concurrent.futures import ThreadPoolExecutor, as_completed
    t0 = time.time()
    with ThreadPoolExecutor(max_workers=workers) as ex:
        for _ in as_completed([ex.submit(run_job, j) for j in jobs]):
            pass
    fh.close(); jfh.close()

    print(f"\n=== stage {stage}{('/' + tag) if tag else ''} done: {counts['done']} "
          f"trials in {time.time() - t0:.0f}s ===")
    print(f"unparseable first responses (retried): {counts['invalid']}")
    print(f"trials lost (retry also failed)      : {counts['lost']}")
    print(f"API errors                           : {counts['error']}")
    print(f"raw CSV   : {csv_path}")
    print(f"raw JSONL : {jsonl_path}")
    return csv_path


def load_analysis_rows(path):
    """Valid, non-superseded rows only - exactly one per planned trial."""
    return [r for r in csv.DictReader(open(path))
            if r["included_in_analysis"] in ("True", "true", True)]
