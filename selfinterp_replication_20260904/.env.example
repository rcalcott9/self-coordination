# Azure AI Foundry -- resource "self-coord" (rg: self_coord)
# Portal: project -> Overview / "Keys and Endpoint". Never commit the real .env.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=<key1>
AZURE_OPENAI_API_VERSION=2024-10-21
# Region matters: Standard SFT for gpt-4o / gpt-4.1 requires North Central US or
# Sweden Central. Elsewhere you must use trainingType=GlobalStandard.
AZURE_REGION=
